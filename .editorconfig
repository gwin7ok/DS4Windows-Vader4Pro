# EditorConfig is used by Roslyn/OmniSharp to control analyzer severities
root = true

[*.cs]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = false
trim_trailing_whitespace = true


# Roslyn コードスタイル推奨 (IDExxxx) を問題タブから一括非表示にする
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0028.severity = none
dotnet_diagnostic.IDE0300.severity = none

# C# code style rules
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Suppress specific C# compiler errors that are false positives for WPF
# CS0103: The name 'X' does not exist in the current context (for XAML elements)
dotnet_diagnostic.CS0103.severity = none

# Suppress other common WPF-related false positives
dotnet_diagnostic.CS0234.severity = none
dotnet_diagnostic.CS0246.severity = none
dotnet_diagnostic.CS0122.severity = none
dotnet_diagnostic.CS1061.severity = none
dotnet_diagnostic.CS0103.severity = none

[*.xaml]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 2
insert_final_newline = false
trim_trailing_whitespace = true

# コア層（DS4Control, DI, Actions）は、WPF UI層(DS4WinWPF)とは意図的に分離し
# 「DS4Windows」名前空間を採用するアーキテクチャ設計であるため、
# フォルダ構造と名前空間を一致させるコードスタイル規約の適用外として宣言する
[DS4Windows/{DS4Control,DI,Actions}/**.cs]
dotnet_style_namespace_match_folder = false

# Win32 P/Invoke 移行推奨（SYSLIB1054）および情報レベルの提案メッセージを抑制
[*.cs]
dotnet_diagnostic.SYSLIB1054.severity = none
dotnet_diagnostic.SYSLIB1050.severity = none
dotnet_diagnostic.SYSLIB1051.severity = none
dotnet_diagnostic.SYSLIB1052.severity = none
dotnet_diagnostic.SYSLIB1053.severity = none