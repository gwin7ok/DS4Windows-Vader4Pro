{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Release win-x64",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish",
                "./DS4Windows/DS4WinWPF.csproj",
                "-c",
                "Release",
                "/p:platform=x64",
                "/p:AppendTargetFrameworkToOutputPath=false",
                "-o",
                "./DS4Windows/bin/x64/Release"
            ],
            "group": "build",
            "presentation": {
                "showReuseMessage": false
            }
        },
        {
            "label": "post-build-x64",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./scripts/post-build.ps1",
                "${workspaceFolder}/DS4Windows/bin/x64/Release",
                "${workspaceFolder}/DS4Windows"
            ],
            "group": "build",
            "dependsOn": "Release win-x64",
            "presentation": {
                "showReuseMessage": false
            }
        },
        {
            "label": "Publish: (Release win-x64)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Remove bin",
                "Release win-x64",
                "post-build-x64"
            ],
            "group": {
                "kind": "build",
            }
        },
        {
            "label": "Remove bin",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "./scripts/Remove bin.bat"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "release-tag-and-push-short",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./scripts/release-tag.ps1",
                "-WithV"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "release: publish-and-create-release",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./scripts/release-and-publish.ps1",
                "-WithV",
                "-SkipBuild"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "./DS4Windows/DS4WinWPF.csproj",
                "-c",
                "Debug",
                "/p:platform=x64",
                "-o",
                "./DS4Windows/bin/x64/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "showReuseMessage": false
            }
        }
    ]
}